# Backend – Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve gerekirse düzenleyin.

# Groq Cloud API Anahtarı (https://console.groq.com adresinden ücretsiz alınabilir)
GROQ_API_KEY=senin_groq_api_keyin

# Kullanılacak Model (Örn: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b
